<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>developer-id</string>
	<key>signingStyle</key>
<%- if cloud_signing? -%>
	<string>automatic</string>
<%- else -%>
	<string>manual</string>
	<key>signingCertificate</key>
	<string><%= codesign_identity.encode xml: :text %></string>
<%- end -%>
	<key>teamID</key>
	<string><%= config.macos.codesign_team_id %></string>
	<key>destination</key>
	<string><%= notarize.include?(:submit) ? 'upload' : 'export' %></string>
</dict>
</plist>

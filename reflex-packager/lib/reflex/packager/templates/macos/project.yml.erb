name: <%= target %>

options:
  deploymentTarget:
    macOS: "<%= config.macos.deployment_target %>"

settings:
  base:
    PRODUCT_BUNDLE_IDENTIFIER: <%= config.bundle_id %>
    MARKETING_VERSION: <%= config.display_version.to_json %>
    CURRENT_PROJECT_VERSION: <%= config.build_version.to_json %>
    ARCHS: <%= config.macos.archs.join ' ' %>
    ONLY_ACTIVE_ARCH: NO
    CODE_SIGN_IDENTITY: <%= config.macos.codesign_identity.inspect %>
<%- if config.macos.codesign_team_id -%>
    DEVELOPMENT_TEAM: <%= config.macos.codesign_team_id %>
<%- end -%>
    CLANG_CXX_LANGUAGE_STANDARD: c++20
    CLANG_ENABLE_OBJC_ARC: NO
    HEADER_SEARCH_PATHS: <%= header_search_paths.to_json %>
    SYSTEM_HEADER_SEARCH_PATHS: <%= system_header_search_paths.to_json %>
    OTHER_LDFLAGS: [-lz, -lffi]

targets:
  <%= target %>:
    type: application
    platform: macOS
    sources:
      - path: src
      - path: app
        type: folder
        buildPhase: resources
      - path: boot.rb
        buildPhase: resources
<%- Dir.glob('*.bundle', base: File.join(build_dir, 'Bundles')).sort.each do |bundle| -%>
      - path: Bundles/<%= bundle %>
        buildPhase: resources
<%- end -%>
<%- if config.icon -%>
      - path: AppIcon.icns
        buildPhase: resources
<%- end -%>
      - path: <%= File.join(cruby_dir, 'src').to_json %>
        name: CRuby
<%- build_infos.each do |lib, info| -%>
<%-   root  = lib.root -%>
<%-   flags = info[:defs].map {"-D#{_1}"}.join ' ' -%>
<%-   unless info[:srcs].empty? -%>
      - path: <%= root.to_json %>
        name: <%= lib %>
        includes: <%= info[:srcs].map {_1.delete_prefix "#{root}/"}.to_json %>
        compilerFlags: <%= flags.to_json %>
<%-   end -%>
<%-   unless info[:vendor_srcs].empty? -%>
      - path: <%= File.join(root, 'vendor').to_json %>
        name: <%= lib %>-vendor
        includes: <%= info[:vendor_srcs].map {_1.delete_prefix "#{root}/vendor/"}.to_json %>
        compilerFlags: <%= "#{flags} -w".to_json %>
<%-   end -%>
<%- end -%>
    dependencies:
      - framework: <%= File.join(cruby_dir, 'CRuby', 'CRuby.xcframework').to_json %>
        embed: false
<%- frameworks.each do |framework| -%>
      - sdk: <%= framework %>.framework
<%- end -%>
    info:
      path: src/Info.plist
      properties:
        CFBundleName: <%= config.name.inspect %>
        CFBundleDisplayName: <%= config.name.inspect %>
        CFBundleShortVersionString: <%= config.display_version.to_json %>
        CFBundleVersion: <%= config.build_version.to_json %>
<%- if config.copyright -%>
        NSHumanReadableCopyright: <%= config.copyright.to_json %>
<%- end -%>
        NSHighResolutionCapable: true
<%- if config.localizations.size > 1 -%>
        LSHasLocalizedDisplayName: true
<%- end -%>
<%- if config.icon -%>
        CFBundleIconFile: AppIcon
<%- end -%>

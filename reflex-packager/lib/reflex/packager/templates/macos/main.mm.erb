// -*- mode: objc -*-
#import <Cocoa/Cocoa.h>
#import <CRuby.h>


extern "C"
{
<%- extensions.each do |ext| -%>
	void Init_<%= ext %> ();
<%- end -%>
}


int
main (int argc, const char* argv[])
{
	@autoreleasepool
	{
<%- extensions.each do |ext| -%>
		[CRuby addExtension:@"<%= ext %>" init:^{Init_<%= ext %>();}];
<%- end -%>

		for (NSString* lib in @[<%= libraries.map {"@\"#{_1}\""}.join ', ' %>])
			[CRuby addLibrary:lib bundle:NSBundle.mainBundle];

		NSString* boot = [NSBundle.mainBundle.resourcePath stringByAppendingPathComponent:@"boot.rb"];
		[CRuby start:boot rescue:^(CRBValue* exception) {}];
	}
	return 0;
}

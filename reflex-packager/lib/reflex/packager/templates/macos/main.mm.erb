// -*- mode: objc -*-
#import <Cocoa/Cocoa.h>
#import <CRuby.h>
#include <locale.h>


extern "C"
{
<%- extensions.each do |ext| -%>
	void Init_<%= ext %> ();
<%- end -%>
}


int
main (int argc, const char* argv[])
{
	// for non-ASCII paths, before initializing CRuby
	setlocale(LC_CTYPE, "UTF-8");

	@autoreleasepool
	{
<%- extensions.each do |ext| -%>
		[CRuby addExtension:@"<%= ext %>" init:^{Init_<%= ext %>();}];
<%- end -%>

		for (NSString* lib in @[<%= lib_names.reverse.map {"@\"#{_1}\""}.join ', ' %>])
			[CRuby addLibrary:lib bundle:NSBundle.mainBundle];

		// the arguments of the command line, as ARGV of the app, as on Windows,
		// once CRuby is set up by the first evaluation
		if (argc > 1)
		{
			[CRuby evaluate:@"nil"];
			ruby_set_argv(argc - 1, (char**) argv + 1);
		}

		NSString* boot = [NSBundle.mainBundle.resourcePath stringByAppendingPathComponent:@"boot.rb"];
		return [CRuby start:boot rescue:^(CRBValue* exception) {
			CRBValue* message = [exception call:@"full_message" rescue:^(CRBValue* e) {}];
			NSLog(@"%@", (message ?: [exception call:@"class"]).toString);
		}];
	}
}

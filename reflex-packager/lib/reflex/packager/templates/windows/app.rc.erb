// application manifest (RT_MANIFEST)
1 24 "app.manifest"
<%- if config.icon -%>

// icon of the executable, and of its windows through this id
1 ICON "app.ico"
<%- end -%>

// shown in the properties of the executable, and as the name of the
// process in the task manager
1 VERSIONINFO
FILEVERSION    <%= file_version   .tr '.', ',' %>
PRODUCTVERSION <%= product_version.tr '.', ',' %>
FILEOS         0x40004// VOS_NT_WINDOWS32
FILETYPE       0x1// VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
<%- config.localizations.each do |lang, values| -%>
    BLOCK "<%= "%04X04B0" % langid(lang) %>"// <%= lang %>, Unicode
    BEGIN
      VALUE "FileDescription",  <%= rc_string values[:name] %>
      VALUE "FileVersion",      <%= rc_string config.build_version %>
      VALUE "InternalName",     <%= rc_string target %>
<%-   if values[:copyright] -%>
      VALUE "LegalCopyright",   <%= rc_string values[:copyright] %>
<%-   end -%>
      VALUE "OriginalFilename", <%= rc_string "#{target}.exe" %>
      VALUE "ProductName",      <%= rc_string values[:name] %>
      VALUE "ProductVersion",   <%= rc_string config.display_version %>
    END
<%- end -%>
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", <%= config.localizations.keys.map {"0x%x, 1200" % langid(_1)}.join ", " %>
  END
END

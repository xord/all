%w[<%= load_dirs.join ' ' %>].reverse_each do |dir|
  $LOAD_PATH.unshift File.join(__dir__, dir, 'lib')
end

Dir.chdir File.join(__dir__, 'app')
$LOAD_PATH.unshift Dir.pwd

begin
  load File.join(Dir.pwd, <%= start_script.dump %>)
<%- unless config.windows.console? -%>
rescue SystemExit, SignalException
  raise
rescue Exception => e
  # no console to print it to
  begin
    require 'reflex'
    # the paths from here, without the lines of this script and of what loads it
    dirs    = Regexp.union [File.dirname(__FILE__), __dir__].map {"#{_1}/"}
    message = e.full_message(highlight: false).lines
      .reject {_1.match? %r{^\s+from (eval|#{Regexp.escape __FILE__}):}}
      .join
      .gsub(dirs, '')
    Reflex.alert message, title: <%= config.name.dump %>
  rescue Exception => alert_error
    $stderr.puts "failed to alert: #{alert_error.message} (#{alert_error.class})"
  end
  raise
<%- end -%>
end

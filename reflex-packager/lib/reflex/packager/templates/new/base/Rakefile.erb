require 'xot/rake'
require '<%= rake %>'


# rake package, archive, release, clean and clobber
package_application

# rake changelog:update, then a commit of ChangeLog.md raises VERSION, and
# a tag of the version, made on CI, releases the app
automate_release

# rake test, running test/**/test_*.rb
test_application


task :default => :run

task :run do
  sh '<%= run %>'
end

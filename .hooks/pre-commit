#!/usr/bin/env ruby

load './xot/lib/xot/rake/hooks/pre-commit'


RENAMES = {reflex: 'reflexion'}

def ls_files(regexp)
  `git ls-files`
    .lines(chomp: true)
    .select {|path| path =~ regexp}
end

def get_version(path)
  File.read(path)[/[\d\.]+/]
end

begin
  gemspec_paths = ls_files /\.gemspec$/
  versions      = ls_files(%r|/VERSION$|)
    .map {|path| [path[%r|([\w\-]+)/VERSION$|, 1], get_version(path)]}
    .to_h
    .transform_values {|ver| (ver.split('.') + [0, 0, 0]).first(3).join('.')}

  gemspec_paths.each do |path|
    gemspec = File.read path
    old     = gemspec.dup

    versions.each do |name, min_ver|
      gem = RENAMES[name.to_sym].then {|s| s || name}
      re  = /add_dependency.*['"]#{gem}['"].*['"]\s*~>\s*[\d\.]+\s*['"]/
      gemspec.sub!(re) {|line| line.sub(/~>\s*([\d\.]+)/) {|s| s.sub $1, min_ver}}
    end

    if gemspec != old
      raise "modified gemspec(s) exist" unless
        gemspec_paths.all? {|path| `git diff #{path}`.empty?}

      File.write path, gemspec
      `git add #{path}`
    end
  end
end
